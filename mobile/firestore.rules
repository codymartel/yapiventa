rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────────────────────────────────────────────────────────────
    // Helpers compartidos
    // ─────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // El usuario autenticado es dueño del negocio indicado por su id.
    function esDuenoNegocio(negocioId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/negocios/$(negocioId)).data.propietarioUid == request.auth.uid;
    }

    function esDuenoNegocioDespues(negocioId) {
      return isSignedIn() && negocioId is string &&
        getAfter(/databases/$(database)/documents/negocios/$(negocioId)).data.propietarioUid == request.auth.uid;
    }

    function esNegocioNuevoDelUsuarioDespues(negocioId) {
      return negocioId is string &&
        !exists(/databases/$(database)/documents/negocios/$(negocioId)) &&
        esDuenoNegocioDespues(negocioId);
    }

    // Valida que la data de un doc público corresponda a un negocio que
    // el usuario autenticado efectivamente posee. Los docs de
    // negocios_publicos no llevan propietarioUid, así que se resuelve
    // contra el negocio referenciado por data.negocioId.
    function esDuenoNegocioPublico(datos) {
      return datos.negocioId is string && esDuenoNegocio(datos.negocioId);
    }

    function esDuenoNegocioPublicoDespues(datos) {
      return datos.negocioId is string &&
        esDuenoNegocioDespues(datos.negocioId);
    }

    // Forma válida de un pedido NUEVO creado por la tienda pública (anónima).
    // Las reglas no tienen bucles: no pueden revisar cada línea ni comprobar
    // el total contra el catálogo. Por eso se acota todo lo demás (campos,
    // tamaños, enteros, total = subtotal + delivery - descuento) y el panel
    // recalcula con los precios de hoy al confirmar. Sin get(): no suma
    // lecturas por cada pedido.
    function pedidoNuevoValido(negocioId, d) {
      let suma = d.subtotalCentavos + d.deliveryCentavos - d.descuentoCentavos;
      return d.keys().hasOnly([
          'negocioId', 'clave', 'estado', 'tipoEntrega', 'fecha', 'cliente',
          'zona', 'deliveryCentavos', 'descuentoCentavos', 'subtotalCentavos',
          'totalCentavos', 'lineas', 'metodoPago', 'estadoPago', 'notas',
          'stockDescontado', 'reembolso', 'historial'
        ]) &&
        d.keys().hasAll([
          'negocioId', 'clave', 'estado', 'tipoEntrega', 'fecha', 'cliente',
          'deliveryCentavos', 'descuentoCentavos', 'subtotalCentavos',
          'totalCentavos', 'lineas', 'estadoPago'
        ]) &&
        d.negocioId == negocioId &&
        d.clave is string && d.clave.size() == 6 &&
        d.estado == 'nuevo' &&
        d.estadoPago == 'pendiente' &&
        d.tipoEntrega in ['delivery', 'recojo'] &&
        d.fecha == request.time &&
        clientePedidoValido(d.cliente) &&
        d.get('zona', '') is string && d.get('zona', '').size() <= 60 &&
        d.get('metodoPago', '') is string && d.get('metodoPago', '').size() <= 30 &&
        d.get('notas', '') is string && d.get('notas', '').size() <= 500 &&
        d.lineas is list && d.lineas.size() >= 1 && d.lineas.size() <= 30 &&
        d.subtotalCentavos is int &&
        d.subtotalCentavos >= 0 && d.subtotalCentavos <= 100000000 &&
        d.deliveryCentavos is int &&
        d.deliveryCentavos >= 0 && d.deliveryCentavos <= 1000000 &&
        d.descuentoCentavos is int &&
        d.descuentoCentavos >= 0 && d.descuentoCentavos <= 100000000 &&
        d.totalCentavos is int &&
        (d.totalCentavos == suma || (suma < 0 && d.totalCentavos == 0)) &&
        d.get('reembolso', 'ninguno') == 'ninguno' &&
        d.get('stockDescontado', []).size() == 0 &&
        d.get('historial', []).size() <= 1;
    }

    // Cliente de un pedido (tienda o mostrador): solo texto y tamaños acotados.
    function clientePedidoValido(c) {
      return c is map &&
        c.keys().hasOnly(['nombre', 'telefono', 'direccion', 'correo']) &&
        c.get('nombre', '') is string &&
        c.get('nombre', '').size() <= 80 &&
        c.get('telefono', '') is string &&
        c.get('telefono', '').size() <= 20 &&
        c.get('direccion', '') is string &&
        c.get('direccion', '').size() <= 200 &&
        c.get('correo', '') is string &&
        c.get('correo', '').size() <= 120;
    }

    // Venta de MOSTRADOR (Caja): la crea SOLO el dueño del negocio. En el local
    // y recojo nace entregada y cobrada; el delivery nace confirmado. Lleva el
    // stock descontado (lo que anular devuelve) y su historial. Sin get(): la
    // regla de dueño del documento ya lo comprueba.
    function ventaMostradorValida(negocioId, d) {
      let suma = d.subtotalCentavos + d.deliveryCentavos - d.descuentoCentavos;
      return d.keys().hasOnly([
          'negocioId', 'clave', 'estado', 'origen', 'enLocal', 'tipoEntrega',
          'fecha', 'cliente', 'zona', 'deliveryCentavos', 'descuentoCentavos',
          'subtotalCentavos', 'totalCentavos', 'lineas', 'metodoPago',
          'estadoPago', 'notas', 'stockDescontado', 'reembolso', 'historial',
          'actualizadoEn'
        ]) &&
        d.keys().hasAll([
          'negocioId', 'clave', 'estado', 'origen', 'tipoEntrega', 'fecha',
          'cliente', 'deliveryCentavos', 'descuentoCentavos',
          'subtotalCentavos', 'totalCentavos', 'lineas', 'estadoPago',
          'stockDescontado', 'historial'
        ]) &&
        d.negocioId == negocioId &&
        d.clave is string && d.clave.size() == 6 &&
        d.origen == 'mostrador' &&
        ((d.tipoEntrega == 'recojo' && d.estado == 'entregado' &&
            d.estadoPago == 'pagado') ||
          (d.tipoEntrega == 'delivery' && d.estado == 'confirmado' &&
            d.estadoPago in ['pendiente', 'pagado'])) &&
        d.get('enLocal', false) is bool &&
        (d.get('enLocal', false) == false || d.tipoEntrega == 'recojo') &&
        d.fecha == request.time &&
        clientePedidoValido(d.cliente) &&
        d.get('zona', '') is string && d.get('zona', '').size() <= 60 &&
        d.get('metodoPago', '') is string && d.get('metodoPago', '').size() <= 30 &&
        d.get('notas', '') is string && d.get('notas', '').size() <= 500 &&
        d.lineas is list && d.lineas.size() >= 1 && d.lineas.size() <= 30 &&
        d.subtotalCentavos is int &&
        d.subtotalCentavos >= 0 && d.subtotalCentavos <= 100000000 &&
        d.deliveryCentavos is int &&
        d.deliveryCentavos >= 0 && d.deliveryCentavos <= 1000000 &&
        d.descuentoCentavos is int &&
        d.descuentoCentavos >= 0 && d.descuentoCentavos <= 100000000 &&
        d.totalCentavos is int &&
        (d.totalCentavos == suma || (suma < 0 && d.totalCentavos == 0)) &&
        d.get('reembolso', 'ninguno') == 'ninguno' &&
        d.stockDescontado is list && d.stockDescontado.size() <= 300 &&
        d.historial is list && d.historial.size() >= 1 && d.historial.size() <= 2 &&
        (!('actualizadoEn' in d) || d.actualizadoEn == request.time);
    }

    // Contadores del día: enteros >= 0 y mapas de como máximo 251 entradas
    // (250 productos distintos por día más «otros»).
    function contadoresDiaValidos(d) {
      return (!('mostradorCentavos' in d) ||
          (d.mostradorCentavos is int && d.mostradorCentavos >= 0)) &&
        (!('mostrador' in d) || (d.mostrador is int && d.mostrador >= 0)) &&
        (!('anuladas' in d) || (d.anuladas is int && d.anuladas >= 0)) &&
        (!('anuladasCentavos' in d) ||
          (d.anuladasCentavos is int && d.anuladasCentavos >= 0)) &&
        (!('porPago' in d) || (d.porPago is map && d.porPago.size() <= 251)) &&
        (!('porEntrega' in d) || (d.porEntrega is map && d.porEntrega.size() <= 251)) &&
        (!('porHora' in d) || (d.porHora is map && d.porHora.size() <= 251)) &&
        (!('porProducto' in d) || (d.porProducto is map && d.porProducto.size() <= 251)) &&
        (!('porVariante' in d) || (d.porVariante is map && d.porVariante.size() <= 251)) &&
        (!('porCombo' in d) || (d.porCombo is map && d.porCombo.size() <= 251));
    }

    // Resumen de ventas de un día (negocios/{id}/resumenes/AAAA-MM-DD): solo
    // enteros >= 0, como máximo 5 entregados recientes, los contadores del día
    // (ver contadoresDiaValidos) y ningún campo extra.
    function resumenDiaValido(d) {
      return d.keys().hasOnly([
          'ventasCentavos',
          'entregados',
          'confirmados',
          'sumaMinutosConfirmar',
          'ultimosEntregados',
          'actualizadoEn',
          'mostradorCentavos',
          'mostrador',
          'anuladas',
          'anuladasCentavos',
          'porPago',
          'porEntrega',
          'porHora',
          'porProducto',
          'porVariante',
          'porCombo'
        ]) &&
        contadoresDiaValidos(d) &&
        (!('ventasCentavos' in d) || (d.ventasCentavos is int && d.ventasCentavos >= 0)) &&
        (!('entregados' in d) || (d.entregados is int && d.entregados >= 0)) &&
        (!('confirmados' in d) || (d.confirmados is int && d.confirmados >= 0)) &&
        (!('sumaMinutosConfirmar' in d) ||
          (d.sumaMinutosConfirmar is int && d.sumaMinutosConfirmar >= 0)) &&
        (!('ultimosEntregados' in d) ||
          (d.ultimosEntregados is list && d.ultimosEntregados.size() <= 5)) &&
        (!('actualizadoEn' in d) || d.actualizadoEn is timestamp);
    }

    function camposPerfilPermitidos(datos) {
      return datos.keys().hasOnly([
        'email',
        'terminosAceptados',
        'createdAt',
        'negocioId'
      ]);
    }

    function createdAtValidoEnCreacion(datos) {
      return !datos.keys().hasAny(['createdAt']) || datos.createdAt is timestamp;
    }

    function negocioIdValidoEnActualizacion() {
      let teniaNegocioId = resource.data.keys().hasAny(['negocioId']);
      let tieneNegocioId = request.resource.data.keys().hasAny(['negocioId']);
      return teniaNegocioId
        ? tieneNegocioId &&
          request.resource.data.negocioId == resource.data.negocioId
        : !tieneNegocioId ||
          esNegocioNuevoDelUsuarioDespues(request.resource.data.negocioId);
    }

    function cambioWebPrivadoSincronizado(negocioId, datosAntes, datosDespues) {
      let publicoAntes = get(
        /databases/$(database)/documents/negocios_publicos/$(datosDespues.slug)
      );
      let publicoDespues = getAfter(
        /databases/$(database)/documents/negocios_publicos/$(datosDespues.slug)
      );
      return datosDespues.slug is string &&
        datosDespues.slug == datosAntes.slug &&
        datosDespues.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        publicoAntes.data.negocioId == negocioId &&
        publicoAntes.data.webActiva is bool &&
        publicoAntes.data.webActiva == datosAntes.webActiva &&
        publicoDespues.data.negocioId == negocioId &&
        publicoDespues.data.webActiva is bool &&
        publicoDespues.data.webActiva == datosDespues.webActiva;
    }

    function proyeccionWebActivaValida(slug, datos) {
      let negocio = getAfter(
        /databases/$(database)/documents/negocios/$(datos.negocioId)
      );
      return datos.webActiva is bool &&
        negocio.data.slug == slug &&
        negocio.data.webActiva is bool &&
        datos.webActiva == negocio.data.webActiva;
    }

    function cambioWebPublicoSincronizado(datosAntes, datosDespues) {
      let negocioAntes = get(
        /databases/$(database)/documents/negocios/$(datosAntes.negocioId)
      );
      let negocioDespues = getAfter(
        /databases/$(database)/documents/negocios/$(datosDespues.negocioId)
      );
      return !datosDespues.diff(datosAntes).affectedKeys().hasAny(['webActiva']) ||
        (negocioAntes.data.webActiva is bool &&
          negocioAntes.data.webActiva == datosAntes.webActiva &&
          negocioDespues.data.webActiva is bool &&
          negocioDespues.data.webActiva == datosDespues.webActiva);
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{userId}
    //   Solo conserva identidad, términos y el vínculo inmutable al negocio.
    //   Los campos legacy existentes pueden permanecer, pero no cambiar.
    // ─────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
        camposPerfilPermitidos(request.resource.data) &&
        createdAtValidoEnCreacion(request.resource.data) &&
        (!request.resource.data.keys().hasAny(['negocioId']) ||
          esNegocioNuevoDelUsuarioDespues(request.resource.data.negocioId));
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'terminosAceptados',
          'negocioId'
        ]) &&
        negocioIdValidoEnActualizacion();
      allow delete: if false;

      // users/{userId}/plan/{planId} — privado al propietario.
      match /plan/{planId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // negocios/{negocioId}
    //   Creación: propietarioUid debe coincidir con el uid autenticado.
    //   Lectura/edición/eliminación: solo el propietario.
    // ─────────────────────────────────────────────────────────────────────
    match /negocios/{negocioId} {
      allow read: if isSignedIn() &&
        resource.data.propietarioUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.propietarioUid == request.auth.uid &&
        request.resource.data.webActiva is bool;
      allow update: if isSignedIn() &&
        resource.data.propietarioUid == request.auth.uid &&
        request.resource.data.propietarioUid == resource.data.propietarioUid &&
        request.resource.data.webActiva is bool &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['webActiva']) ||
          cambioWebPrivadoSincronizado(
            negocioId,
            resource.data,
            request.resource.data
          ));
      allow delete: if isSignedIn() &&
        resource.data.propietarioUid == request.auth.uid;

      // Subcolecciones privadas del negocio.
      match /reclamaciones/{document=**} {
        allow read, write: if false;
      }
      match /promociones/{document=**} {
        allow read, write: if false;
      }
      match /suscripcion/{document=**} {
        allow read, write: if false;
      }
      match /inventario_privado/{document=**} {
        allow read, write: if false;
      }

      // negocios/{negocioId}/pedidos/{pedidoId}
      //   Cualquiera (tienda pública anónima) CREA un pedido nuevo con la forma
      //   válida; nadie puede leerlo ni cambiarlo desde fuera. Solo el dueño
      //   crea una venta de mostrador (origen 'mostrador', ya entregada o
      //   confirmada): la tienda anónima no puede usar ese origen.
      //   El propietario lee y cambia solo estado, pago, reembolso, stock
      //   descontado e historial. Nunca se borra.
      match /pedidos/{pedidoId} {
        allow create: if pedidoNuevoValido(negocioId, request.resource.data) ||
          (esDuenoNegocio(negocioId) &&
            ventaMostradorValida(negocioId, request.resource.data));
        allow read: if esDuenoNegocio(negocioId);
        allow update: if esDuenoNegocio(negocioId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado',
            'estadoPago',
            'reembolso',
            'stockDescontado',
            'historial',
            'actualizadoEn'
          ]);
        allow delete: if false;
      }

      // negocios/{negocioId}/resumenes/{dia}
      //   Resumen de ventas de un día (id AAAA-MM-DD). Solo el propietario lo
      //   lee y lo actualiza (el panel lo escribe dentro de la transacción de
      //   confirmar y entregar). Nunca se borra.
      match /resumenes/{dia} {
        allow read: if esDuenoNegocio(negocioId);
        allow create, update: if esDuenoNegocio(negocioId) &&
          dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          resumenDiaValido(request.resource.data);
        allow delete: if false;
      }

      // negocios/{negocioId}/productos/{productoId}
      //   Propietario: lee y administra todos sus productos.
      //   Visitantes: solo lectura de productos con disponible == true
      //   (la tienda pública consulta where('disponible', '==', true)).
      //   El producto conserva siempre el negocioId correcto.
      match /productos/{productoId} {
        allow read: if esDuenoNegocio(negocioId) || resource.data.disponible == true;
        allow create: if esDuenoNegocio(negocioId) &&
          request.resource.data.negocioId == negocioId;
        allow update: if esDuenoNegocio(negocioId) &&
          request.resource.data.negocioId == negocioId;
        allow delete: if esDuenoNegocio(negocioId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // negocios_publicos/{slug}
    //   Lectura pública SOLO si webActiva == true.
    //   El propietario lee su documento aunque esté desactivado.
    //   Solo el propietario crea, edita o elimina.
    //   El negocioId no puede cambiar en una actualización.
    // ─────────────────────────────────────────────────────────────────────
    match /negocios_publicos/{slug} {
      allow read: if resource.data.webActiva == true ||
        esDuenoNegocioPublico(resource.data);

      allow create: if isSignedIn() &&
        esDuenoNegocioPublicoDespues(request.resource.data) &&
        proyeccionWebActivaValida(slug, request.resource.data);

      allow update: if isSignedIn() &&
        esDuenoNegocioPublico(resource.data) &&
        request.resource.data.negocioId == resource.data.negocioId &&
        proyeccionWebActivaValida(slug, request.resource.data) &&
        cambioWebPublicoSincronizado(resource.data, request.resource.data);

      allow delete: if isSignedIn() &&
        esDuenoNegocioPublico(resource.data);
    }

    // ─────────────────────────────────────────────────────────────────────
    // Ruta final: deniega explícitamente cualquier ruta no declarada.
    // ─────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
